# Copy to .env and fill in. .env is git-ignored; `make` compiles these into
# the Atari programs (via obj/config.h), so they never appear in src/.

# Cloudflare AI Gateway: https://gateway.ai.cloudflare.com/v1/<account>/<gateway>/...
AIG_ACCOUNT_ID=
AIG_GATEWAY=

# Model, in AI Gateway's unified (OpenAI-compatible) form: provider/model
AIG_MODEL=anthropic/claude-sonnet-5

# Cloudflare API token, sent as cf-aig-authorization. Needed when the gateway
# has authentication turned on, which Unified Billing requires. Scope the
# token to AI Gateway only: it ends up inside the Atari program.
AIG_TOKEN=

# The provider's own API key. Leave empty with Unified Billing (Cloudflare
# bills you) or when the key is stored in the gateway (BYOK).
PROVIDER_API_KEY=
